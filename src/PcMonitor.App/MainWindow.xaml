<Window x:Class="PcMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcMonitor.App.ViewModels"
        xmlns:c="clr-namespace:PcMonitor.App.Controls"
        xmlns:local="clr-namespace:PcMonitor.App"
        xmlns:core="clr-namespace:PcMonitor.Core;assembly=PcMonitor.Core"
        Title="PC Monitor" Width="1600" Height="1000" MinWidth="480" MinHeight="360"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        Topmost="{Binding AlwaysOnTop}"
        WindowStartupLocation="Manual" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />
        <local:EqualsConverter x:Key="Equals" />

        <!-- Auto layout: wrap unscaled cards. Scaled layouts: cards packed into columns, scaled by MainWindow.ApplyLayout. -->
        <ItemsPanelTemplate x:Key="WrapCards">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridCards">
            <c:MasonryPanel Columns="{Binding GridColumns}" ColumnWidth="{Binding ColumnWidth}" VerticalAlignment="Top" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="HeroTemplate" DataType="{x:Type vm:MetricViewModel}">
            <!-- Sizes come from core:CardMetrics (HeroGap, HeroUnitGap, fonts); UI tests check the text fits. -->
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,-2,0,0">
                    <TextBlock Text="{Binding Value}" FontSize="{x:Static core:CardMetrics.HeroValueFontSize}" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                    <TextBlock Text="{Binding Unit}" FontSize="{x:Static core:CardMetrics.HeroUnitFontSize}" Margin="6,0,0,9" VerticalAlignment="Bottom" Foreground="{StaticResource DimBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding MinMax}" Style="{StaticResource Caption}" FontSize="{x:Static core:CardMetrics.HeroMinMaxFontSize}" TextWrapping="Wrap" />
                <c:Sparkline Height="{Binding DataContext.SparkHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,0" Points="{Binding History}" Stroke="{Binding SparkBrush}" Unit="{Binding ValueUnit}"
                             Minimum="{Binding RangeMin}" Maximum="{Binding RangeMax}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CardViewModel}">
            <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    Margin="{Binding DataContext.CardMargin, RelativeSource={RelativeSource AncestorType=Window}}" Padding="{Binding DataContext.CardPadding, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="10"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="14"
                                   Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Grid Margin="{Binding DataContext.HeroMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0" Content="{Binding Hero}" ContentTemplate="{StaticResource HeroTemplate}" Focusable="False" />
                        <ContentControl Grid.Column="1" Content="{Binding SecondHero}" ContentTemplate="{StaticResource HeroTemplate}" Focusable="False"
                                        Visibility="{Binding HasSecondHero, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <TextBlock Text="{Binding Notice}" Foreground="{StaticResource NoticeBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4"
                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0" Grid.IsSharedSizeScope="True" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MetricViewModel}">
                                <!-- [label][gap][value + unit][gap][min/max]. Label and value columns are Auto (shared across
                                     the card), so a value is never squeezed; min/max takes the rest and wraps between its halves.
                                     Sizes come from core:CardMetrics; UI tests check that the text fits at 0.55, 0.68 and 1.0. -->
                                <Grid Margin="{Binding DataContext.RowMargin, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Reason}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="{x:Static core:CardMetrics.LabelMinWidth}" />
                                        <ColumnDefinition Width="Auto" MinWidth="{x:Static core:CardMetrics.ColumnGap}" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Value" MinWidth="{x:Static core:CardMetrics.ValueMinWidth}" />
                                        <ColumnDefinition Width="Auto" MinWidth="{x:Static core:CardMetrics.ColumnGap}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="{x:Static core:CardMetrics.LabelFontSize}"
                                               MaxWidth="{x:Static core:CardMetrics.LabelMaxWidth}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" FontSize="{x:Static core:CardMetrics.ValueFontSize}" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                        <TextBlock Text="{Binding Unit}" FontSize="{x:Static core:CardMetrics.UnitFontSize}" Margin="4,0,0,1" VerticalAlignment="Bottom" Foreground="{StaticResource DimBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding MinMax}" Style="{StaticResource Caption}" FontSize="{x:Static core:CardMetrics.MinMaxFontSize}"
                                               TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding Reason, StringFormat='n/a because: {0}'}"
                                               Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap"
                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                        <Border.Visibility>
                            <MultiBinding Converter="{x:Static local:AllTrueToVisibility.Instance}">
                                <Binding Path="HasSpecs" />
                                <Binding Path="DataContext.SpecsVisible" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </Border.Visibility>
                        <ItemsControl ItemsSource="{Binding Specs}" Grid.IsSharedSizeScope="True" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SpecLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="Root" Background="{StaticResource BgBrush}">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="PC Monitor" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding VersionLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,3,20,0" />
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Update" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <RadioButton GroupName="rate" Content="0.5 s" IsChecked="{Binding UpdateInterval, Converter={StaticResource Equals}, ConverterParameter=0.5}" />
                    <RadioButton GroupName="rate" Content="1 s" IsChecked="{Binding UpdateInterval, Converter={StaticResource Equals}, ConverterParameter=1}" />
                    <RadioButton GroupName="rate" Content="2 s" IsChecked="{Binding UpdateInterval, Converter={StaticResource Equals}, ConverterParameter=2}" />
                    <TextBlock Text="│" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center" />
                    <RadioButton GroupName="unit" Content="°C" IsChecked="{Binding IsFahrenheit, Converter={StaticResource Invert}}" />
                    <RadioButton GroupName="unit" Content="°F" IsChecked="{Binding IsFahrenheit}" />
                    <TextBlock Text="│" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center" />
                    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="Show specs" IsChecked="{Binding ShowSpecs}" />
                    <TextBlock Text="│" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Layout (L)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LayoutBox" Width="130" VerticalAlignment="Center" Focusable="False" Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding LayoutOptions}" DisplayMemberPath="Name" SelectedValuePath="Mode"
                              SelectedValue="{Binding Layout}" />
                    <CheckBox Content="Compact" IsChecked="{Binding Compact}" />
                    <TextBlock Text="│" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DarkButton}" Content="Reset min/max" Command="{Binding ResetMinMaxCommand}" />
                    <Button Style="{StaticResource DarkButton}" Content="Fullscreen (F11)" Click="OnFullscreenClick" />
                </WrapPanel>
                <TextBlock />
            </DockPanel>
        </Border>

        <!-- PawnIO banner -->
        <Border DockPanel.Dock="Top" Margin="16,12,16,0" Padding="16,10" CornerRadius="8"
                Background="{StaticResource BannerBrush}" BorderBrush="{StaticResource BannerBorderBrush}" BorderThickness="1"
                Visibility="{Binding PawnIoBannerVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DarkButton}" Content="Get PawnIO (pawnio.eu)" Command="{Binding OpenPawnIoCommand}" />
                    <Button Style="{StaticResource DarkButton}" Content="Recheck" Command="{Binding RecheckCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CPU temperature needs the PawnIO driver" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BannerBorderBrush}" />
                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                        <Run Text="{Binding PawnIoDetail, Mode=OneWay}" />
                        <Run Text=" Install it, then press Recheck. All other readings keep working without it." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="12" />
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
            <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Cards}" Focusable="False" ItemsPanel="{StaticResource WrapCards}" />
        </ScrollViewer>
    </DockPanel>
</Window>
